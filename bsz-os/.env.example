# ==============================================================================
# ASTRA Health · BSZ-OS Environment Configuration
# ==============================================================================
# Copy this file to '.env' to customize:
#   cp .env.example .env
#
# NOTE: All settings have sensible defaults. BSZ-OS works completely out-of-the-box
# without creating a .env file!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Server Settings
# ------------------------------------------------------------------------------
# Host interface to bind the local server.
# Default: 127.0.0.1 (localhost only)
# Set to 0.0.0.0 to expose BSZ-OS across the local spacecraft / pod LAN.
BSZ_HOST=127.0.0.1

# Port for the web interface and API.
# Default: 8787
BSZ_PORT=8787

# ------------------------------------------------------------------------------
# 2. Local AI Assistant (Zibo) & Hardware Acceleration
# ------------------------------------------------------------------------------
# Number of neural network layers to offload to GPU:
#   -1   = Offload all layers to GPU (fastest, requires NVIDIA CUDA with >= 3.5GB VRAM)
#    0   = Force CPU-only inference (no GPU required)
#   1-28 = Partial offload (hybrid GPU/CPU if VRAM is constrained)
# Default: -1 (auto-detects CUDA GPU on startup)
BSZ_AI_GPU_LAYERS=-1

# Context window size in tokens for the local LLM.
# Default: dynamically determined by available VRAM (8192 on >=4GB VRAM, 4096 on CPU)
BSZ_AI_CONTEXT=8192

# Maximum new tokens to generate per reply.
# Default: 384
BSZ_AI_MAX_TOKENS=384

# Prompt processing batch size.
# Default: 512 for GPU, 256 for CPU
BSZ_AI_BATCH=512

# Automatic dependency bootstrap:
#   1 = Automatically install llama-cpp-python into .venv if missing (default)
#   0 = Disable automatic pip installations (manual environment management)
BSZ_AI_AUTO_INSTALL=1

# ------------------------------------------------------------------------------
# 3. Model Paths (Optional Overrides)
# ------------------------------------------------------------------------------
# By default, BSZ-OS automatically discovers GGUF models in:
#   1. bsz-os/models/
#   2. bsz-os/
#   3. models/ (in repository root)
#   4. repository root
#
# Only set these variables if you store models in a custom directory:
# BSZ_LLM_MODEL=/path/to/Llama-3.2-3B-Instruct-Medical-Finetuned-merged.Q4_K_M.gguf
# BSZ_EMBED_MODEL=/path/to/nomic-embed-text-v1.5.f16.gguf
